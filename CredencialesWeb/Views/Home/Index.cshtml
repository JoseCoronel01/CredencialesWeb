@model IEnumerable<CredencialesWeb.Models.Menu>

@{
    ViewData["Title"] = "Home Page";
}

@{
    if (Model != null)
    {
        <div class="container-fluid">
            <div class="row">
                <div class="col-xl-12">
                    <ul>
                        @foreach (var item in Model)
                        {
                            <li><strong>@item.MenuItem</strong>
                                <ul>
                                    @{
                                        if (item.SubMenuItems != null)
                                        {
                                            foreach (SubMenu subitem in @item.SubMenuItems)
                                            {
                                                <li>
                                                    <a href="@subitem.SubItem" target="_blank">@subitem.SubItem</a>
                                                </li>                                                
                                            }
                                        }
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>        
    }
}